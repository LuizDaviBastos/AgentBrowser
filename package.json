{
  "name": "agent-browser-api",
  "version": "0.1.0",
  "private": true,
  "description": "API server for browser-agent jobs backed by an external browser MCP worker",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "tsc -p tsconfig.json && node --test dist/tests/smoke.test.js dist/tests/server.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "vite": "^5.4.8",
    "typescript": "^5.9.2"
  }
}
